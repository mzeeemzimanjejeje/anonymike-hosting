{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "artifacts/api-server/public/**",
          "artifacts/api-server/schema.sql"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "artifacts/api-server/api/index.js"
    }
  ]
}
