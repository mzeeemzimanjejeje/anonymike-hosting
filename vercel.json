{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "maxDuration": 60,
        "memory": 1024,
        "includeFiles": [
          "artifacts/api-server/public/**",
          "artifacts/api-server/schema.sql"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "artifacts/api-server/api/index.js"
    }
  ],
  "env": {
    "SERVE_STATIC": "true",
    "NODE_ENV": "production"
  }
}
