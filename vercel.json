{
  "version": 2,
  "buildCommand": "cd artifacts/api-server && npm install --omit=dev --no-audit --no-fund",
  "builds": [
    {
      "src": "artifacts/api-server/api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "artifacts/api-server/public/**",
          "artifacts/api-server/schema.sql"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "artifacts/api-server/api/index.js"
    }
  ],
  "env": {
    "SERVE_STATIC": "true",
    "NODE_ENV": "production"
  },
  "functions": {
    "artifacts/api-server/api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
