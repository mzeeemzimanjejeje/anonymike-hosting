modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "admin@courtneytech.xyz"
LOG_LEVEL = "info"
NODE_ENV = "production"
SERVE_STATIC = "true"
CLOUDFLARE_ZONE_ID = "a1c50eac098866b6e2de830a6a0106d8"
GITHUB_CLIENT_ID = "Ov23liYds7tYRCbVfU1m"
GOOGLE_CLIENT_ID = "840004396655-fhvkaedjsg87vk9k8n35vp6ulomh7rsi.apps.googleusercontent.com"
PTERODACTYL_URL = "https://apps.courtneytech.xyz"
CLOUDFLARE_API_TOKEN_NOTE = "Use cfut_ token — stored in CLOUDFLARE_API_TOKEN secret"
